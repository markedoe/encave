{
 "about": "Pages an AI cited when it searched the web, read by both apps (AIWebSearch in CaveKit, AiWebSearch in the Kotlin core): each address once, http and https only, at most 8. Claude: the citations of its text, else its search results; Chat Completions (OpenRouter): message.annotations url_citation; Responses (OpenAI, xAI): output message output_text annotations, and the last text holding a JSON object. Read by AIWebSearchTests.swift and AiWebSearchTest.kt.",
 "claude": [
  {
   "note": "citations win over results",
   "blocks": [
    {
     "type": "server_tool_use",
     "name": "web_search",
     "input": {
      "query": "Domaine Martin Chablis 2021"
     }
    },
    {
     "type": "web_search_tool_result",
     "content": [
      {
       "type": "web_search_result",
       "url": "https://a.example/one",
       "title": "One"
      },
      {
       "type": "web_search_result",
       "url": "https://b.example/two",
       "title": "Two"
      }
     ]
    },
    {
     "type": "text",
     "text": "Found it.",
     "citations": [
      {
       "type": "web_search_result_location",
       "url": "https://b.example/two",
       "title": "Two",
       "cited_text": "..."
      },
      {
       "type": "web_search_result_location",
       "url": "https://b.example/two",
       "title": "Two"
      }
     ]
    },
    {
     "type": "text",
     "text": "{\"expected\":{}}"
    }
   ],
   "sources": [
    {
     "url": "https://b.example/two",
     "title": "Two"
    }
   ]
  },
  {
   "note": "no citations: the results, not a file or javascript address",
