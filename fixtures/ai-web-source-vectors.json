    {
     "type": "web_search_tool_result",
     "content": [
      {
       "url": "https://a.example/one",
       "title": "One"
      },
      {
       "url": "javascript:alert(1)",
       "title": "Bad"
      },
      {
       "url": "file:///etc/hosts"
      },
      {
       "url": "http://c.example/three",
       "title": ""
      }
     ]
    },
    {
     "type": "text",
     "text": "{}"
    }
   ],
   "sources": [
    {
     "url": "https://a.example/one",
     "title": "One"
    },
    {
     "url": "http://c.example/three"
    }
   ]
  },
  {
   "note": "a search error",
