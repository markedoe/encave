    {
      "note": "Strict answer: name and vintage read, grapes and region from knowledge",
      "answer": "{\"name\":\"Clos des Lilas\",\"producer\":\"\",\"vintage\":2019,\"color\":\"red\",\"appellation\":\"Pauillac\",\"region\":\"Bordeaux\",\"country\":\"France\",\"grapes\":[\"Cabernet Sauvignon\",\"Merlot\"],\"drinkFrom\":2026,\"drinkUntil\":2040,\"abv\":13.5,\"classification\":\"\",\"sources\":{\"name\":\"label\",\"producer\":\"\",\"vintage\":\"label\",\"color\":\"knowledge\",\"appellation\":\"label\",\"region\":\"knowledge\",\"country\":\"knowledge\",\"grapes\":\"knowledge\",\"drinkWindow\":\"knowledge\",\"abv\":\"label\",\"classification\":\"\"}}",
      "estimated": ["color", "country", "drinkWindow", "grapes", "region"]
    },
    {
      "note": "Everything read on the label: only the window is an estimate",
