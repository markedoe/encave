{
  "about": "Plain http to a server named on the home network, shared by CaveKit (LocalNameTests.swift) and the Kotlin core (LocalNameTest.kt). For an http URL to a name (.local and .home.arpa names too; not an address, not localhost), the name is resolved (here: addresses) and accepted if one of its addresses is local; the request then goes to the best local address (private or loopback IPv4, then unique local or loopback IPv6, then link-local IPv4, then link-local IPv6 without an interface), same scheme, port, path (\"/\" when there is none, as OkHttp writes it) and query. Public and CGNAT (shared, Tailscale) addresses are left out; a link-local address with an interface cannot be used. https, local addresses and localhost are never resolved. error: notLocal (no local address: use https or the server's local address) or notFound (no usable address). choose: the address picked from a list, by its bytes. allow: marks private addresses for scripts/check-public-safety.sh.",
  "resolve": [
    {"url": "http://searxng.home:8888/search?q=wine&format=json", "addresses": ["192.168.1.20"], "expect": "http://192.168.1.20:8888/search?q=wine&format=json", "allow": "public-safety: allow"},
    {"url": "http://nas.lan:8080/dav/encave/", "addresses": ["fd12:3456::20", "10.0.0.20"], "expect": "http://10.0.0.20:8080/dav/encave/", "allow": "public-safety: allow"},
    {"url": "http://ollama:11434/api/tags", "addresses": ["172.16.4.2"], "expect": "http://172.16.4.2:11434/api/tags", "allow": "public-safety: allow"},
    {"url": "http://nas.lan/dav/", "addresses": ["fd12:3456::20"], "expect": "http://[fd12:3456::20]/dav/"},
    {"url": "http://NAS.Lan:8080/", "addresses": ["127.0.0.1"], "expect": "http://127.0.0.1:8080/"},
    {"url": "http://searxng.example:8888/search", "addresses": ["203.0.113.7"], "error": "notLocal"},
    {"url": "http://mixed.home:8888/", "addresses": ["203.0.113.7", "192.168.1.20"], "expect": "http://192.168.1.20:8888/", "allow": "public-safety: allow"},
    {"url": "http://mixed6.home/", "addresses": ["2001:db8::7", "fd12:3456::20"], "expect": "http://[fd12:3456::20]/"},
    {"url": "http://nas.lan:5005/", "addresses": ["2001:db8::20", "100.101.2.3", "192.168.1.30"], "expect": "http://192.168.1.30:5005/", "allow": "public-safety: allow"},
    {"url": "http://nas.lan:5005/", "addresses": ["169.254.3.4", "fd12:3456::20"], "expect": "http://[fd12:3456::20]:5005/", "allow": "public-safety: allow"},
    {"url": "http://tailnet.home:8888/", "addresses": ["100.101.2.3"], "error": "notLocal", "allow": "public-safety: allow"},
    {"url": "http://linklocal.home/", "addresses": ["fe80::1%x"], "error": "notFound"},
    {"url": "http://linklocal.home:8080/", "addresses": ["fe80::1%en0"], "error": "notFound"},
    {"url": "http://nas.lan:8888", "addresses": ["10.0.0.2"], "expect": "http://10.0.0.2:8888/", "allow": "public-safety: allow"},
    {"url": "http://linklocal.home/", "addresses": ["fe80::1%x", "fd12:3456::20"], "expect": "http://[fd12:3456::20]/"},
    {"url": "http://gone.home:8888/", "addresses": [], "error": "notFound"},
    {"url": "https://searxng.home/search", "addresses": ["203.0.113.7"], "expect": "https://searxng.home/search"},
    {"url": "http://nas.local:8080/", "addresses": ["203.0.113.7"], "error": "notLocal"},
    {"url": "http://nas.local:8080/", "addresses": ["192.168.1.30"], "expect": "http://192.168.1.30:8080/", "allow": "public-safety: allow"},
    {"url": "http://nas.home.arpa:8080/", "addresses": ["203.0.113.7"], "error": "notLocal"},
    {"url": "http://nas.home.arpa/dav/", "addresses": ["10.0.0.20"], "expect": "http://10.0.0.20/dav/", "allow": "public-safety: allow"},
    {"url": "http://example..com/", "addresses": ["192.168.1.20"], "error": "notLocal", "allow": "public-safety: allow"},
    {"url": "http://localhost:11434/api/tags", "addresses": ["203.0.113.7"], "expect": "http://localhost:11434/api/tags"},
    {"url": "http://192.168.1.20:8888/search", "addresses": ["203.0.113.7"], "expect": "http://192.168.1.20:8888/search", "allow": "public-safety: allow"},
    {"url": "http://203.0.113.7:8888/", "addresses": ["192.168.1.20"], "error": "notLocal", "allow": "public-safety: allow"}
  ],
  "choose": [
    {"addresses": ["0:0:0:0:0:0:0:1"], "expect": "0:0:0:0:0:0:0:1"},
    {"addresses": ["fd12:3456:0:0:0:0:0:20", "2001:db8::7"], "expect": "fd12:3456:0:0:0:0:0:20"},
    {"addresses": ["::ffff:192.168.1.20"], "error": "notLocal", "allow": "public-safety: allow"},
    {"addresses": ["fe80::1"], "expect": "fe80::1"},
    {"addresses": ["fe80::1%wlan0", "2001:db8::7"], "error": "notFound"},
    {"addresses": ["2001:db8::7"], "error": "notLocal"}
  ],
  "mayBeLocal": {
    "accepted": ["localhost", "nas.local", "nas.home.arpa", "searxng.home", "nas.lan", "ollama", "[fd12:3456::20]", "fe80::1"],
    "refused": ["203.0.113.7", "8.8.8.8", "010.0.0.1", "2001:db8::7", "[2001:db8::7]"]
  }
}
