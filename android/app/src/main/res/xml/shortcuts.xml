<?xml version="1.0" encoding="utf-8"?>
<!-- Static app shortcuts (long press on the app icon). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="encave://scan"
            android:targetClass="app.encave.MainActivity"
            android:targetPackage="app.encave" />
    </shortcut>
    <shortcut
        android:shortcutId="tonight"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_tonight"
        android:shortcutShortLabel="@string/nav_tonight"
        android:shortcutLongLabel="@string/shortcut_tonight">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="encave://tonight"
            android:targetClass="app.encave.MainActivity"
            android:targetPackage="app.encave" />
    </shortcut>
</shortcuts>
