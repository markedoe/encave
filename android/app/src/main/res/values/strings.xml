    <string name="help_field_search">Type a few letters of the name to add bottles of a wine you already have.</string>
    <string name="help_field_existing">Choose it to add bottles without typing the wine again.</string>
    <string name="help_field_quantity">How many identical bottles you add.</string>
    <string name="help_field_size">Half bottle 37.5 cl, bottle 75 cl, magnum 1.5 l, double magnum 3 l.</string>
    <string name="help_bottles_footer">Each bottle is tracked on its own, so you can drink or move them one by one.</string>
    <string name="help_field_storage">For bottles that are not in a rack.</string>
    <string name="help_location_footer">Choose a rack to see exactly where the bottles are, or note where they are kept.</string>
    <string name="help_field_price">Used for the value of your cellar in Insights. The currency is set in Settings.</string>
    <string name="help_field_place">Shop, estate or website.</string>
    <string name="help_field_received">Who gave you the bottle.</string>
    <string name="help_purchase_footer">Optional. Helps you remember where to buy a wine again and what your cellar is worth.</string>
    <string name="help_field_name">The name on the label, without the vintage. Required.</string>
    <string name="help_field_producer">The estate, domaine or house that made the wine.</string>
    <string name="help_field_vintage">The harvest year on the label. Leave empty for a wine without a year.</string>
    <string name="help_style_footer">Used for colors, serving temperature, the estimated drinking window and food pairing.</string>
    <string name="help_field_appellation">The protected name of origin, such as Pauillac or Chablis.</string>
    <string name="help_field_region">The wine region, such as Bordeaux or Tuscany.</string>
    <string name="help_field_grapes">Grape varieties, separated by commas.</string>
    <string name="help_origin_footer">Optional. Makes search and food pairing better. Separate grapes with commas.</string>
    <string name="help_window_footer">The years when the wine is at its best, from the producer or a guide. Used by Tonight to suggest what to open.</string>
    <string name="help_notes_footer">About the wine itself. Notes on a bottle you opened go in its tasting.</string>
    <string name="help_field_rating">From one star (disappointing) to five (exceptional). Tap the same star again to clear it.</string>
    <string name="help_field_note">A few words to remember the bottle.</string>
    <string name="help_tasting_footer">Everything is optional and can be changed later from the Journal.</string>
    <string name="help_field_appearance">Color, intensity, clarity.</string>
    <string name="help_field_nose">Aromas: fruit, flowers, spices, wood…</string>
    <string name="help_field_palate">Taste and structure: sweetness, acidity, tannins, body.</string>
    <string name="help_field_finish">How long the flavors last after swallowing.</string>
    <string name="help_field_food">What you ate with it, to remember good pairings.</string>
    <string name="help_full_note_footer">A structured note: appearance, nose, palate, finish and the food you had with it.</string>
    <string name="help_field_rack_name">A name you will recognize: cellar left wall, kitchen fridge…</string>
    <string name="help_kind_footer">Describe each place where you keep bottles: a rack, a wine fridge, a set of bins.</string>
    <string name="help_field_rows">Counted from the top. Rows are lettered A, B, C…</string>
    <string name="help_field_columns">Counted from the left. Places are numbered 1, 2, 3…</string>
    <string name="help_field_grid_depth">Deep racks hold a second bottle behind the first one.</string>
    <string name="help_field_shelf_depth">How many bottles fit one behind the other on a shelf.</string>
    <string name="help_field_bin">A diamond bin of about 30 cm holds around 10 standard bottles.</string>
    <string name="help_rack_holds">Holds %1$d bottles. Places are named by row letter and number, like B3; B3-2 is the second bottle in a cell.</string>
    <string name="help_field_discovery_place">Where you had it, to find the wine again later.</string>
    <string name="help_where_footer">Search in the Journal also looks in the place, notes and tags.</string>
    <string name="help_tags_footer">Your own groups, such as gift ideas or for summer. Tap a tag to select it, or type a new one and press Done. Filter by tag in the Journal.</string>
    <string name="help_field_price_seen">The price on the wine list or in the shop, to compare when you buy it.</string>
    <string name="help_field_ai_provider">The AI service that reads label photos. You need an account and an API key with it.</string>
    <string name="help_field_ai_url">Leave empty for the provider’s usual address. For a local server, its address on your network.</string>
    <string name="help_field_ai_key">Created on the provider’s website. Encrypted with the Android Keystore on this device.</string>
    <string name="help_field_ai_model">Choose a model that reads images. Larger models are more accurate but slower and cost more.</string>
    <string name="ai_create_key_at">Create an API key at %1$s</string>
