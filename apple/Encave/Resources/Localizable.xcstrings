      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grande cave, 120"
          }
        }
      }
    },
    "Large wine fridge": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grande cave à vin"
          }
        }
      }
    },
    "Large, 10 × 12": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grand, 10 × 12"
          }
        }
      }
    },
    "Last attempt failed: %@": {
      "localizations": {
        "fr": {
