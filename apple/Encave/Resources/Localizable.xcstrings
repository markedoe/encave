          "stringUnit": {
            "state": "translated",
            "value": "Actuel : %@"
          }
        }
      }
    },
    "Now: not set": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuel : non renseigné"
          }
        }
      }
    },
    "Number of Bottles": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de bouteilles"
          }
        }
      }
    },
    "OK": {
      "localizations": {
