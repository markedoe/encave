            "value": "Alcool"
          }
        }
      }
    },
    "Alcohol by volume, as printed on the label.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Degré d’alcool, tel qu’imprimé sur l’étiquette."
          }
        }
      }
    },
    "Alcohol, in percent": {
      "localizations": {
        "fr": {
