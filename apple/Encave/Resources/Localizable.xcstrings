          }
        }
      }
    },
    "Open in New Window": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir dans une nouvelle fenêtre"
          }
        }
      }
    },
    "Open the provider's page with the link below the key field, create a key and paste it. The key is stored in the Keychain on this device, never synced, exported or backed up, and sent only to that provider.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la page du fournisseur avec le lien sous le champ de la clé, créez une clé et collez-la. La clé est conservée dans le trousseau de cet appareil, n’est jamais synchronisée, exportée ni sauvegardée, et n’est envoyée qu’à ce fournisseur."
          }
        }
      }
    },
    "Open the selected wine in a new window (Mac and iPad)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le vin sélectionné dans une nouvelle fenêtre (Mac et iPad)"
          }
