    "Wines deleted: %lld": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vins supprimés : %lld"
          }
        }
      }
    },
    "Wines tasted elsewhere are not counted as bottles in your cellar and do not appear in Storage or Tonight.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vins goûtés ailleurs ne comptent pas comme des bouteilles de votre cave et n’apparaissent ni dans Rangements ni dans Ce soir."
          }
        }
      }
    },
    "Wines to buy appear under To buy in the Journal. Wines tasted elsewhere are not counted as bottles in your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vins à acheter apparaissent sous À acheter dans le Journal. Les vins goûtés ailleurs ne comptent pas comme des bouteilles de votre cave."
          }
        }
      }
    },
    "Wines with bottles": {
      "localizations": {
        "fr": {
