          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter"
          }
        }
      }
    },
    "Opens Encave on the label scanner to add bottles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Encave pour scanner l’étiquette et ajouter des bouteilles."
          }
        }
      }
    },
    "Opens Encave to add bottles, by scanning the label or typing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Encave pour ajouter des bouteilles, en scannant l’étiquette ou en saisissant."
          }
        }
      }
    },
    "Opens Settings, then choose Devices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les réglages ; choisissez ensuite Appareils."
          }
        }
      }
    },
    "Opens a form, then the share sheet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un formulaire, puis la feuille de partage."
