    "Note a Wine Tasted Elsewhere…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter un vin goûté ailleurs…"
          }
        }
      }
    },
    "Note a bottle opened from your cellar or a wine tasted elsewhere": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter une bouteille ouverte de votre cave ou un vin goûté ailleurs"
          }
        }
      }
    },
    "Note a wine tasted elsewhere": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter un vin goûté ailleurs"
          }
        }
      }
    },
    "Notes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes"
          }
        }
      }
    },
    "Notes about this wine": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes sur ce vin"
          }
        }
      }
    },
    "Nothing bundled matches this wine yet. Add its grapes, appellation or style, or ask the AI.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun profil fourni ne correspond encore à ce vin. Ajoutez ses cépages, son appellation ou son style, ou demandez à l’IA."
          }
        }
      }
    },
    "Nothing here yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l’instant"
          }
        }
      }
    },
    "Nothing is at its peak right now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est à son apogée en ce moment"
          }
        }
      }
    },
    "Nothing is looked up online until you choose a service in **Settings › Web Search**.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est cherché en ligne tant que vous n’avez pas choisi un service dans **Réglages › Recherche web**."
          }
        }
      }
    },
    "Nothing new in these results.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau dans ces résultats."
          }
        }
      }
    },
    "Nothing new: everything in this file is already in your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau : tout ce que contient ce fichier est déjà dans votre cave."
          }
        }
      }
    },
    "Nothing to guess": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à deviner"
          }
        }
      }
    },
    "Nothing to suggest yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à suggérer pour l’instant"
          }
        }
      }
    },
    "Notifications are off for Encave. Turn them on in the system settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Encave. Activez-les dans les réglages du système."
          }
        }
      }
    },
    "Novice": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novice"
          }
        }
      }
    },
    "Now ready: %lld": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désormais prêtes : %lld"
          }
        }
      }
    },
    "Now: %@": {
      "localizations": {
