    "Keeps devices in sync when they are not on the same Wi-Fi, through storage that only holds encrypted data: iCloud, a WebDAV folder or a relay.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les appareils synchronisés quand ils ne sont pas sur le même Wi-Fi, grâce à un stockage qui ne contient que des données chiffrées : iCloud, un dossier WebDAV ou un relais."
          }
        }
      }
    },
    "Kept for %@": {
      "localizations": {
