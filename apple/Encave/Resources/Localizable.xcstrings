    "Wine, producer, region, grape, vintage": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vin, producteur, région, cépage, millésime"
          }
        }
      }
    },
    "Wines to buy appear in the shopping list in Journal. Discoveries are not counted as bottles in your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vins à acheter apparaissent dans la liste d’achats du Journal. Les découvertes ne comptent pas comme des bouteilles de votre cave."
          }
        }
      }
    },
    "With AI (optional)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l’IA (facultatif)"
          }
        }
      }
    },
    "With Ollama or LM Studio on your computer, choose **Local server** and enter its address, such as `http://localhost:11434/v1` on the Mac. On iPhone and iPad, use the computer's name or address on your network instead of localhost.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Ollama ou LM Studio sur votre ordinateur, choisissez **Serveur local** et saisissez son adresse, comme `http://localhost:11434/v1` sur le Mac. Sur iPhone et iPad, utilisez le nom ou l’adresse de l’ordinateur sur votre réseau au lieu de localhost."
          }
        }
      }
    },
    "With friends": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre amis"
          }
        }
      }
    },
    "Works out the window from the style and the vintage. Turn off to enter the years yourself.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déduit la fenêtre du type et du millésime. Désactivez pour saisir les années vous-même."
          }
        }
      }
    },
    "Your cellar could not be loaded.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger votre cave."
          }
        }
      }
    },
