      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plat servi"
          }
        }
      }
    },
    "For a rack with a sloped top, a staircase or an irregular cellar wall.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un casier sous pente, sous un escalier ou contre un mur irrégulier."
          }
        }
      }
    },
    "For bottles that are not in a rack.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les bouteilles qui ne sont pas dans un casier."
          }
        }
      }
    },
    "For devices signed in to the same Apple Account. Uses a little of your iCloud storage; Apple only receives encrypted files.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les appareils connectés au même compte Apple. Utilise un peu de votre stockage iCloud ; Apple ne reçoit que des fichiers chiffrés."
          }
        }
      }
    },
    "For iPhone, iPad and Mac today, and Android later. A relay is a small open-source service: run your own on a home server or a free Cloudflare account, or use one run by someone you trust.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour iPhone, iPad et Mac aujourd’hui, et Android plus tard. Un relais est un petit service open source : hébergez le vôtre sur un serveur à la maison ou un compte Cloudflare gratuit, ou utilisez celui d’une personne de confiance."
          }
        }
      }
    },
    "For summer": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l’été"
          }
        }
      }
    },
    "Fortified": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
