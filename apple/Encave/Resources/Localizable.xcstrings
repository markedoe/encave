    },
    "Your cellar is stored only on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cave est enregistrée uniquement sur cet appareil."
          }
        }
      }
    },
    "Your cellar is stored only on your devices. There is no account, no tracking and no advertising.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cave est stockée uniquement sur vos appareils. Pas de compte, pas de pistage, pas de publicité."
          }
        }
      }
    },
    "Your cellar stays yours.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cave reste la vôtre."
          }
        }
