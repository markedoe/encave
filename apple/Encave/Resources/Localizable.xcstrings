            "value": "Végétal"
          }
        }
      }
    },
    "High": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élevé"
          }
        }
      }
    },
    "High [feminine]": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élevée"
          }
        }
      }
    },
    "Holds %lld bottles": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient %lld bouteilles"
          }
        }
      }
    },
    "Holds %lld bottles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient %lld bouteilles."
          }
        }
      }
    },
    "Holds %lld bottles. Bins are named like “Bin B3”: rows lettered from the top, bins numbered from the left.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottle. Bins are named like “Bin B3”: rows lettered from the top, bins numbered from the left."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottles. Bins are named like “Bin B3”: rows lettered from the top, bins numbered from the left."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteille. Les cases sont nommées comme « Case B3 » : rangées par lettre depuis le haut, cases numérotées depuis la gauche."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteilles. Les cases sont nommées comme « Case B3 » : rangées par lettre depuis le haut, cases numérotées depuis la gauche."
                }
              }
            }
          }
        }
      }
    },
    "Holds %lld bottles. Positions are named like B3; with two bottles in a position, “B3, back” is the one behind.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottle. Positions are named like B3; with two bottles in a position, “B3, back” is the one behind."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottles. Positions are named like B3; with two bottles in a position, “B3, back” is the one behind."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteille. Les positions sont nommées comme B3 ; avec deux bouteilles par position, « B3, fond » est celle de derrière."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteilles. Les positions sont nommées comme B3 ; avec deux bouteilles par position, « B3, fond » est celle de derrière."
                }
              }
            }
          }
        }
      }
    },
    "Holds %lld bottles. Shelves are numbered from the top, positions from the left.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottle. Shelves are numbered from the top, positions from the left."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottles. Shelves are numbered from the top, positions from the left."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteille. Les étagères sont numérotées depuis le haut, les positions depuis la gauche."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteilles. Les étagères sont numérotées depuis le haut, les positions depuis la gauche."
                }
              }
            }
          }
        }
      }
    },
    "Holds %lld bottles. Shelves are numbered from the top, positions from the left. Each shelf has its layers, its depth and, two deep, whether its back bottles lie head-to-tail: it then shows its front bottles, then the ones behind. Touch and hold a shelf to duplicate it or apply it to all shelves.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient %lld bouteilles. Les étagères sont numérotées depuis le haut, les positions depuis la gauche. Chaque étagère a ses couches, sa profondeur et, sur deux rangs, ses bouteilles du fond tête-bêche ou non : elle montre alors ses bouteilles de devant, puis celles du fond. Touchez longuement une étagère pour la dupliquer ou l’appliquer à toutes les étagères."
          }
        }
      }
    },
    "Honey": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miel"
          }
        }
      }
    },
    "Honey and dried fruit": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miel et fruits secs"
          }
        }
      }
    },
    "Honeycomb": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid d’abeille"
          }
        }
      }
    },
    "Honeycomb rack": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casier nid d’abeille"
          }
        }
      }
    },
    "How changes come together": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment les modifications se combinent"
          }
        }
      }
    },
    "How long the flavors last after swallowing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps les saveurs persistent après avoir avalé."
          }
        }
      }
    },
    "How many bottles fit one behind the other in each position.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de bouteilles tiennent l’une derrière l’autre à chaque position."
          }
        }
      }
    },
    "How many bottles fit one behind the other on a shelf.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de bouteilles tiennent l’une derrière l’autre sur une étagère."
          }
        }
      }
    },
    "How many identical bottles you add.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de bouteilles identiques vous ajoutez."
          }
        }
      }
    },
    "How much sugar was added after the second fermentation, from Brut Nature to Doux.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sucre ajouté après la seconde fermentation, de Brut nature à Doux."
          }
        }
      }
    },
    "How often": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence"
          }
        }
      }
    },
    "How sync works": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment marche la synchronisation"
          }
        }
      }
    },
    "How to Run a Relay": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Héberger un relais"
          }
        }
      }
    },
    "How to set up AI": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment configurer l’IA"
          }
        }
      }
    },
    "How to set up web search": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment configurer la recherche web"
          }
        }
      }
    },
    "How was it?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’était comment ?"
          }
        }
      }
    },
    "Hue": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte"
          }
        }
      }
    },
    "Ideas": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idées"
          }
        }
      }
    },
    "If an AI service is set up in Settings, the label photo is also sent to it to fill in or complete the name, producer, vintage, style, appellation, region, country, grapes and drinking window, and the alcohol and classification printed on the label. No need to wait: if you add the bottles first, the answer completes the wine afterwards, and one banner says so; its **Undo** takes back the bottles and the AI's details together. Only that photo is sent, never your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un service d’IA est configuré dans les réglages, la photo de l’étiquette lui est aussi envoyée pour remplir ou compléter le nom, le producteur, le millésime, le style, l’appellation, la région, le pays, les cépages, la fenêtre de dégustation, ainsi que le degré d’alcool et la classification imprimés sur l’étiquette. Inutile d’attendre : si vous ajoutez les bouteilles avant, la réponse complète le vin ensuite, et un seul bandeau l’indique ; son **Annuler** retire ensemble les bouteilles et les informations de l’IA. Seule cette photo est envoyée, jamais votre cave."
          }
        }
      }
    },
    "Image": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image"
          }
        }
      }
    },
    "Import": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer"
          }
        }
      }
    },
    "Imported %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importé : %@."
          }
        }
      }
    },
    "Import…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer…"
          }
        }
      }
    },
    "In **Devices › Sync Away from Home**, **How often** sets how often this device syncs away from home by itself: every minute (the default), every 5 or 15 minutes, or only when you tap **Sync Now**. Background sync on iPhone and iPad follows it, no more often than iOS allows. On the same Wi-Fi, changes are still sent a few seconds after you make them. The setting is for this device only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans **Appareils › Synchroniser loin de la maison**, **Fréquence** règle la fréquence à laquelle cet appareil se synchronise à distance de lui-même : toutes les minutes (par défaut), toutes les 5 ou 15 minutes, ou seulement quand vous touchez **Synchroniser**. La synchronisation en arrière-plan sur iPhone et iPad la suit, sans dépasser ce qu’iOS permet. Sur le même Wi-Fi, les modifications partent toujours quelques secondes après les avoir faites. Ce réglage ne concerne que cet appareil."
          }
        }
      }
    },
    "In **Settings › AI › Connections**, tap **Add Connection** and choose a provider. You need an account with it and an API key; the provider bills you directly for what you use, usually a fraction of a cent per label. You can add several connections, also to the same service (two OpenRouter accounts, for example): give each a name to tell them apart.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans **Réglages › IA › Connexions**, touchez **Ajouter une connexion** et choisissez un fournisseur. Il vous faut un compte chez lui et une clé d’API ; le fournisseur vous facture directement ce que vous utilisez, en général une fraction de centime par étiquette. Vous pouvez ajouter plusieurs connexions, même au même service (deux comptes OpenRouter, par exemple) : donnez un nom à chacune pour les distinguer."
          }
        }
      }
    },
    "In **Settings › AI › Models**, tap **Add Model**, choose a connection, then a model from its list (through OpenRouter, only the models that read images are listed) or type its name. Put them in your order of preference by dragging them (on iPhone and iPad, tap **Edit** first); swipe one to delete it. **Test** sends a made-up label bundled with Encave, never one of your photos, to check the key and that the model reads images.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans **Réglages › IA › Modèles**, touchez **Ajouter un modèle**, choisissez une connexion, puis un modèle de sa liste (par OpenRouter, seuls les modèles qui lisent les images sont listés) ou saisissez son nom. Mettez-les dans votre ordre de préférence en les faisant glisser (sur iPhone et iPad, touchez d’abord **Modifier**) ; balayez-en un pour le supprimer. **Tester** envoie une étiquette fictive fournie avec Encave, jamais une de vos photos, pour vérifier la clé et que le modèle lit les images."
          }
        }
      }
    },
    "In Control Center, tap +, then Add a Control, and choose **Add Bottles**: it opens Encave on the label scanner. You can also put it on the Lock Screen or on the Action button.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le centre de contrôle, touchez +, puis Ajouter une commande, et choisissez **Ajouter des bouteilles** : cette commande ouvre Encave pour scanner l’étiquette. Vous pouvez aussi la placer sur l’écran verrouillé ou sur le bouton Action."
          }
        }
      }
    },
    "In LM Studio, load a vision model and start the server; turn on “Serve on Local Network” to use it from iPhone or iPad.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans LM Studio, chargez un modèle de vision et démarrez le serveur ; activez « Serve on Local Network » pour l’utiliser depuis l’iPhone ou l’iPad."
          }
        }
      }
    },
    "In Shortcuts, **Get Cellar Contents** gives your bottles as text or JSON (all of them, those to open now, on order…), and **Get Wine Details** gives one wine with its tasting notes. An app on this device that runs shortcuts, such as a local AI assistant, can use them to answer questions about your cellar. Encave itself sends nothing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Raccourcis, **Obtenir le contenu de la cave** donne vos bouteilles en texte ou en JSON (toutes, celles à ouvrir maintenant, en commande…), et **Obtenir la fiche d’un vin** donne un vin avec ses notes de dégustation. Une app de cet appareil qui lance des raccourcis, comme un assistant IA local, peut s’en servir pour répondre à vos questions sur votre cave. Encave n’envoie rien."
          }
        }
      }
    },
    "In Storage, touch and hold one and choose **Move Up** or **Move Down**; on the Mac, drag it in the sidebar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Rangements, touchez-en un longuement et choisissez **Monter** ou **Descendre** ; sur Mac, faites-le glisser dans la barre latérale."
          }
        }
      }
    },
    "In grids and honeycombs, rows are lettered from the top and positions numbered from the left: **B3** is the second row, third position. With two bottles in a position, **B3, back** is the one behind. In a wine fridge, shelves are numbered from the top and positions along each shelf: **Shelf 2, position 3**, and the one behind it **Shelf 2, back, position 3**; an empty position shows only its number. In bins, positions read like **Bin B3**. The same name shows on the wine's page, in the bottle list and for Siri.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les casiers en grille et nid d’abeille, les rangées sont nommées par lettre depuis le haut et les positions numérotées depuis la gauche : **B3** est la deuxième rangée, troisième position. Avec deux bouteilles par position, **B3, fond** est celle de derrière. Dans une cave à vin réfrigérée, les étagères sont numérotées depuis le haut et les positions le long de chaque étagère : **Étagère 2, position 3**, et celle derrière **Étagère 2, fond, position 3** ; une position vide n’affiche que son numéro. Dans des cases, les positions se lisent comme **Case B3**. Le même nom s’affiche sur la fiche du vin, dans la liste des bouteilles et pour Siri."
          }
        }
      }
    },
    "In order of preference": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par ordre de préférence"
          }
        }
      }
    },
    "In the Cellar list, tap **Select** in the toolbar (an icon on the iPad), or touch and hold a wine and choose **Select**, then tick the wines, or **Select All** for those the search and filters show. Then put them in storage (bottles already in storage stay where they are), take them out of their positions or, under **More**, keep their bottles for an occasion, mark them as no longer in the cellar or delete them; **Done** ends the selection. In the table on the Mac and the iPad, select several rows (⌘-click or ⇧-click) and right-click them to put them in storage, take them out or delete them. **Undo** puts everything back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la liste de la Cave, touchez **Sélectionner** dans la barre d’outils (une icône sur iPad), ou touchez longuement un vin et choisissez **Sélectionner**, puis cochez les vins, ou **Tout sélectionner** pour ceux que la recherche et les filtres affichent. Mettez-les ensuite dans un rangement (les bouteilles déjà rangées restent où elles sont), sortez-les de leur position ou, dans **Plus**, gardez leurs bouteilles pour une occasion, indiquez qu’elles ne sont plus en cave ou supprimez-les ; **OK** termine la sélection. Dans le tableau sur Mac et iPad, sélectionnez plusieurs lignes (⌘-clic ou ⇧-clic) et faites un clic droit pour les ranger, les sortir ou les supprimer. **Annuler** remet tout en place."
          }
        }
      }
    },
    "In the background, when iOS allows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En arrière-plan, quand iOS le permet"
          }
        }
      }
    },
    "In the cellar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cave"
          }
        }
      }
    },
    "In the guided sheet, **Show What to Expect** opens the wine's expected aromas and structure: closed at first, so they do not lead you. After **Drink**, the aromas you noted are compared with them: “You found 4 of 6 expected aromas”, and the others you found.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la fiche guidée, **Voir ce qui est attendu** ouvre les arômes et la structure attendus du vin : fermés au départ, pour ne pas vous influencer. Après **Boire**, les arômes notés y sont comparés : « Vous avez trouvé 4 des 6 arômes attendus », et ceux trouvés en plus."
          }
        }
      }
    },
    "In this backup": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans cette sauvegarde"
          }
        }
      }
    },
    "In your cellar only": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement dans votre cave"
          }
        }
      }
    },
    "Insights": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiques"
          }
        }
      }
    },
    "Install Ollama": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer Ollama"
          }
        }
      }
    },
    "Install SearXNG": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer SearXNG"
          }
        }
      }
    },
    "Install a local server (Ollama)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer un serveur local (Ollama)"
          }
        }
      }
    },
    "Install a model that reads images, for example: ollama pull gemma3. To use it from iPhone or iPad, start Ollama with OLLAMA_HOST=0.0.0.0 on the computer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez un modèle qui lit les images, par exemple : ollama pull gemma3. Pour l’utiliser depuis l’iPhone ou l’iPad, lancez Ollama avec OLLAMA_HOST=0.0.0.0 sur l’ordinateur."
          }
        }
      }
    },
    "Intensity": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensité"
          }
        }
      }
    },
    "Inventory for Printing (PDF)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventaire à imprimer (PDF)"
          }
        }
      }
    },
    "Invoices, certificates, technical sheets, articles: for every bottle of this wine. They sync with your devices, encrypted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Factures, certificats, fiches techniques, articles : pour toutes les bouteilles de ce vin. Ils se synchronisent avec vos appareils, chiffrés."
          }
        }
      }
    },
    "Irregular racks": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casiers irréguliers"
          }
        }
      }
    },
    "It appears first among the filters, one tap away.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle apparaît en premier parmi les filtres, à portée d’un toucher."
          }
        }
      }
    },
    "It holds no bottles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne contient aucune bouteille."
          }
        }
      }
    },
    "It keeps what it already has, but can no longer sync with your other devices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il garde ce qu’il a déjà, mais ne peut plus se synchroniser avec vos autres appareils."
          }
        }
      }
    },
    "It leaves your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle sort de votre cave."
          }
        }
      }
    },
    "It sees when devices sync, how much they send and their IP addresses.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il voit quand les appareils se synchronisent, combien ils envoient et leurs adresses IP."
          }
        }
      }
    },
    "Italy": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Italie"
