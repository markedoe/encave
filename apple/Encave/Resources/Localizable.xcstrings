        }
      }
    },
    "Check what was read on the label. Tap Edit Details to correct or complete it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez ce qui a été lu sur l’étiquette. Touchez Modifier les détails pour corriger ou compléter."
          }
        }
      }
    },
    "Checking a rack": {
      "localizations": {
        "fr": {
          "stringUnit": {
