    "No Previous Versions Yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de version précédente"
          }
        }
      }
    },
    "No account, no analytics, no advertising. Sync is encrypted from end to end: on the same Wi-Fi your devices connect directly, and away from home the storage you choose holds only encrypted files. If you turn them on, AI label recognition sends only the label photo to your AI service, and web search only the search terms to your search service.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de mesure d’audience, pas de publicité. La synchronisation est chiffrée de bout en bout : sur le même Wi-Fi, vos appareils se connectent directement, et à distance le stockage que vous choisissez ne contient que des fichiers chiffrés. Si vous les activez, la reconnaissance des étiquettes par IA n’envoie que la photo de l’étiquette à votre service d’IA, et la recherche web que les termes de recherche à votre service de recherche."
          }
        }
      }
    },
    "No answer this time. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de réponse cette fois. Réessayez."
          }
        }
      }
    },
    "No aromas found": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun arôme trouvé"
          }
        }
      }
    },
    "No backup for more than a month. Back up now to keep a copy of your cellar, its photos and documents.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sauvegarde depuis plus d’un mois. Sauvegardez maintenant pour garder une copie de votre cave, de ses photos et de ses documents."
          }
        }
      }
    },
    "No bottle in your cellar matches this dish yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune bouteille de votre cave ne correspond encore à ce plat."
