    "Choose a rack to see exactly where the bottles are, or note where they are kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un casier pour savoir exactement où sont les bouteilles, ou indiquez où elles sont rangées."
          }
        }
      }
    },
    "Choose a vintage to estimate the window.": {
