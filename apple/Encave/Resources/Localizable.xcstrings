    "Holds %lld bottles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient %lld bouteilles."
          }
        }
      }
    },
    "Holds %lld bottles. Places are named by row letter and number, like B3; B3-2 is the second bottle in a cell.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottle. Places are named by row letter and number, like B3; B3-2 is the second bottle in a cell."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottles. Places are named by row letter and number, like B3; B3-2 is the second bottle in a cell."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteille. Les emplacements sont nommés par lettre de rangée et numéro, comme B3 ; B3-2 est la deuxième bouteille d’une case."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteilles. Les emplacements sont nommés par lettre de rangée et numéro, comme B3 ; B3-2 est la deuxième bouteille d’une case."
                }
              }
            }
          }
        }
      }
    },
    "Holds %lld bottles. Places are named like B3; with two bottles in a place, “B3, back” is the one behind.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottle. Places are named like B3; with two bottles in a place, “B3, back” is the one behind."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Holds %lld bottles. Places are named like B3; with two bottles in a place, “B3, back” is the one behind."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteille. Les places sont nommées comme B3 ; avec deux bouteilles par place, « B3, derrière » est celle du fond."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Contient %lld bouteilles. Les places sont nommées comme B3 ; avec deux bouteilles par place, « B3, derrière » est celle du fond."
                }
              }
            }
          }
        }
      }
    },
    "Holds %lld bottles. Shelves are numbered from the top, places from the left.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient %lld bouteilles. Les étagères sont numérotées depuis le haut, les places depuis la gauche."
          }
        }
      }
    },
    "Holds %lld bottles. Touch and hold a shelf to duplicate it or apply it to all shelves.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient %lld bouteilles. Touchez longuement une étagère pour la dupliquer ou l’appliquer à toutes les étagères."
          }
        }
      }
    },
    "Honeycomb rack": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casier nid d’abeille"
          }
        }
      }
    },
    "How changes come together": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment les modifications se combinent"
          }
        }
      }
    },
    "How long the flavors last after swallowing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps les saveurs persistent après avoir avalé."
          }
        }
      }
    },
    "How many bottles fit one behind the other in each cell.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de bouteilles tiennent l’une derrière l’autre dans chaque case."
          }
        }
      }
    },
    "How many bottles fit one behind the other on a shelf.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de bouteilles tiennent l’une derrière l’autre sur une étagère."
          }
        }
      }
    },
    "How many identical bottles you add.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de bouteilles identiques vous ajoutez."
          }
        }
      }
    },
    "How often": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence"
          }
        }
      }
    },
    "How sync works": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment marche la synchronisation"
          }
        }
      }
    },
    "How to Run a Relay": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Héberger un relais"
          }
        }
      }
    },
    "How to set up AI": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment configurer l’IA"
          }
        }
      }
    },
    "How to set up web search": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment configurer la recherche web"
          }
        }
      }
    },
    "How was it?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’était comment ?"
          }
        }
      }
    },
    "Ideas": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idées"
          }
        }
      }
    },
    "If an AI service is set up in Settings, the label photo is also sent to it to fill in or complete the name, producer, vintage, style, appellation, region, country, grapes and drinking window. No need to wait: if you add the bottles first, the answer completes the wine afterwards, with **Undo**. Only that photo is sent, never your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un service d’IA est configuré dans les réglages, la photo de l’étiquette lui est aussi envoyée pour remplir ou compléter le nom, le producteur, le millésime, le style, l’appellation, la région, le pays, les cépages et la fenêtre de dégustation. Inutile d’attendre : si vous ajoutez les bouteilles avant, la réponse complète le vin ensuite, avec **Annuler**. Seule cette photo est envoyée, jamais votre cave."
          }
        }
      }
    },
    "Image": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image"
          }
        }
      }
    },
    "Import": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer"
          }
        }
      }
    },
    "Imported %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importé : %@."
          }
        }
      }
    },
    "Import…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer…"
          }
        }
      }
    },
    "In **Devices › Sync Away from Home**, **How often** sets how often this device syncs away from home by itself: every minute (the default), every 5 or 15 minutes, or only when you tap **Sync Now**. Background sync on iPhone and iPad follows it, no more often than iOS allows. On the same Wi-Fi, changes are still sent a few seconds after you make them. The setting is for this device only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans **Appareils › Synchroniser loin de la maison**, **Fréquence** règle la fréquence à laquelle cet appareil se synchronise à distance de lui-même : toutes les minutes (par défaut), toutes les 5 ou 15 minutes, ou seulement quand vous touchez **Synchroniser**. La synchronisation en arrière-plan sur iPhone et iPad la suit, sans dépasser ce qu’iOS permet. Sur le même Wi-Fi, les modifications partent toujours quelques secondes après les avoir faites. Ce réglage ne concerne que cet appareil."
          }
        }
      }
    },
    "In **Settings › AI**, choose a provider. You need an account with it and an API key; the provider bills you directly for what you use, usually a fraction of a cent per label.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans **Réglages › IA**, choisissez un fournisseur. Il vous faut un compte chez lui et une clé d’API ; le fournisseur vous facture directement ce que vous utilisez, en général une fraction de centime par étiquette."
          }
        }
      }
    },
    "In LM Studio, load a vision model and start the server; turn on “Serve on Local Network” to use it from iPhone or iPad.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans LM Studio, chargez un modèle de vision et démarrez le serveur ; activez « Serve on Local Network » pour l’utiliser depuis l’iPhone ou l’iPad."
          }
        }
      }
    },
    "In Shortcuts, **Get Cellar Contents** gives your bottles as text or JSON (all of them, those to open now, on order…), and **Get Wine Details** gives one wine with its tasting notes. An app on this device that runs shortcuts, such as a local AI assistant, can use them to answer questions about your cellar. Encave itself sends nothing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Raccourcis, **Obtenir le contenu de la cave** donne vos bouteilles en texte ou en JSON (toutes, celles à ouvrir maintenant, en commande…), et **Obtenir la fiche d’un vin** donne un vin avec ses notes de dégustation. Une app de cet appareil qui lance des raccourcis, comme un assistant IA local, peut s’en servir pour répondre à vos questions sur votre cave. Encave n’envoie rien."
          }
        }
      }
    },
    "In This Backup": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans cette sauvegarde"
          }
        }
      }
    },
    "In the Cellar list, choose **Select Wines** in the **Sort and Filter** menu and tick the wines, or **Select All** for those the search and filters show. Then place them in a rack (bottles already in a rack stay where they are), take them out of their places or, under **More**, keep their bottles for an occasion, mark them as no longer in the cellar or delete them. In the table on the Mac and the iPad, select several rows (⌘-click or ⇧-click) and right-click them to place them, take them out or delete them. **Undo** puts everything back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la liste de la Cave, choisissez **Sélectionner des vins** dans le menu **Trier et filtrer** et cochez les vins, ou **Tout sélectionner** pour ceux que la recherche et les filtres affichent. Rangez-les ensuite dans un casier (les bouteilles déjà rangées restent à leur place), sortez-les de leur place ou, dans **Plus**, gardez leurs bouteilles pour une occasion, indiquez qu’elles ne sont plus en cave ou supprimez-les. Dans le tableau sur Mac et iPad, sélectionnez plusieurs lignes (⌘-clic ou ⇧-clic) et faites un clic droit pour les ranger, les sortir ou les supprimer. **Annuler** remet tout en place."
          }
        }
      }
    },
    "In the background, when iOS allows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En arrière-plan, quand iOS le permet"
          }
        }
      }
    },
    "In your cellar only": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement dans votre cave"
          }
        }
      }
    },
    "Insights": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiques"
          }
        }
      }
    },
    "Install Ollama": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer Ollama"
          }
        }
      }
    },
    "Install SearXNG": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer SearXNG"
          }
        }
      }
    },
    "Install a local server (Ollama)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer un serveur local (Ollama)"
          }
        }
      }
    },
    "Install a model that reads images, for example: ollama pull gemma3. To use it from iPhone or iPad, start Ollama with OLLAMA_HOST=0.0.0.0 on the computer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez un modèle qui lit les images, par exemple : ollama pull gemma3. Pour l’utiliser depuis l’iPhone ou l’iPad, lancez Ollama avec OLLAMA_HOST=0.0.0.0 sur l’ordinateur."
          }
        }
      }
    },
    "Inventory for Printing (PDF)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventaire à imprimer (PDF)"
          }
        }
      }
    },
    "Invoices, certificates, technical sheets, articles: for every bottle of this wine. They sync with your devices, encrypted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Factures, certificats, fiches techniques, articles : pour toutes les bouteilles de ce vin. Ils se synchronisent avec vos appareils, chiffrés."
          }
        }
      }
    },
    "Irregular racks": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casiers irréguliers"
          }
        }
      }
    },
    "It appears first among the filters, one tap away.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle apparaît en premier parmi les filtres, à portée d’un toucher."
          }
        }
      }
    },
    "It keeps what it already has, but can no longer sync with your other devices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il garde ce qu’il a déjà, mais ne peut plus se synchroniser avec vos autres appareils."
          }
        }
      }
    },
    "It leaves your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle sort de votre cave."
          }
        }
      }
    },
    "It sees when devices sync, how much they send and their IP addresses.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il voit quand les appareils se synchronisent, combien ils envoient et leurs adresses IP."
          }
        }
      }
    },
    "Its bottles, drinking window and tastings appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses bouteilles, sa fenêtre de dégustation et vos dégustations apparaissent ici."
          }
        }
      }
    },
    "It’s a Different Wine": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un autre vin"
          }
        }
      }
    },
    "JSON": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON"
          }
        }
      }
    },
    "Join": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre"
          }
        }
      }
    },
    "Join Another Device’s Cellar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre la cave d’un autre appareil"
          }
        }
      }
    },
    "Join a Cellar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre une cave"
          }
        }
      }
    },
    "Join a Cellar from Another Device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre la cave d’un autre appareil"
          }
        }
      }
    },
    "Join another cellar?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre une autre cave ?"
          }
        }
      }
    },
    "Journal": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal"
          }
        }
      }
    },
    "Journal and shopping list": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal et liste d’achats"
          }
        }
      }
    },
    "Journal entries": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrées du Journal"
          }
        }
      }
    },
    "Keep": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À garder"
          }
        }
      }
    },
    "Keep Bottle": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder la bouteille"
          }
        }
      }
    },
    "Keep Bottles": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les bouteilles"
          }
        }
      }
    },
    "Keep Checking": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer la vérification"
          }
        }
      }
    },
    "Keep Editing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        }
      }
    },
    "Keep Longer": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder plus longtemps"
          }
        }
      }
    },
    "Keep a copy and move your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez une copie et transférez votre cave."
          }
        }
      }
    },
    "Keep an invoice, a certificate of authenticity, a technical sheet or an article with a wine: **Add a Document…** (a PDF, an image, a text or an office file, up to 8 MB) or, on iPhone and iPad, **Scan a Document**, which makes a PDF. Add them while adding bottles, or later under **Documents** on the wine's page: they are for every bottle of the wine. For one bottle only (its certificate, its receipt), touch and hold the bottle on the wine's page and choose **Attach a Document…**, or tap it in a rack and use the paperclip; a paperclip shows how many it has. Tap a document to open it; touch and hold it to share, rename or delete it. Documents sync with your devices, encrypted, and are never sent to the AI service or the web search.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez une facture, un certificat d’authenticité, une fiche technique ou un article avec un vin : **Ajouter un document…** (un PDF, une image, un texte ou un fichier bureautique, jusqu’à 8 Mo) ou, sur iPhone et iPad, **Numériser un document**, qui en fait un PDF. Ajoutez-les en ajoutant des bouteilles, ou plus tard dans **Documents** sur la fiche du vin : ils valent pour toutes les bouteilles du vin. Pour une seule bouteille (son certificat, son ticket), touchez longuement la bouteille sur la fiche du vin et choisissez **Joindre un document…**, ou touchez-la dans un casier puis le trombone ; un trombone indique combien elle en a. Touchez un document pour l’ouvrir ; touchez-le longuement pour le partager, le renommer ou le supprimer. Les documents se synchronisent avec vos appareils, chiffrés, et ne sont jamais envoyés au service d’IA ni à la recherche web."
          }
        }
      }
    },
    "Keep for an Occasion": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder pour une occasion"
          }
        }
      }
    },
    "Keep for an Occasion…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder pour une occasion…"
          }
        }
      }
    },
    "Keep for later": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À garder"
          }
        }
      }
    },
    "Keep track of what you opened and what you thought.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la trace de ce que vous avez ouvert et de ce que vous en avez pensé."
          }
        }
      }
    },
    "Keeping bottles for an occasion": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder des bouteilles pour une occasion"
          }
        }
      }
    },
    "Keeps devices in sync when they are not on the same Wi-Fi, through storage that only holds encrypted data: iCloud, a WebDAV folder or a relay.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les appareils synchronisés quand ils ne sont pas sur le même Wi-Fi, grâce à un stockage qui ne contient que des données chiffrées : iCloud, un dossier WebDAV ou un relais."
          }
        }
      }
    },
    "Kept for %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardée pour %@"
          }
        }
      }
    },
    "Kept for an Occasion": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardées pour une occasion"
          }
        }
      }
    },
    "Kept when Encave could not read your cellar at launch. Share one to keep it elsewhere or to report the problem; delete it when you no longer need it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservés quand Encave n’a pas pu lire votre cave au lancement. Partagez-en un pour le garder ailleurs ou signaler le problème ; supprimez-le quand vous n’en avez plus besoin."
          }
        }
      }
    },
    "Kept with the wine and used for the estimated value of your cellar in Insights. Web prices vary: check them on the sites.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardé avec le vin et utilisé pour la valeur estimée de votre cave dans les Statistiques. Les prix du web varient : vérifiez-les sur les sites."
          }
        }
      }
    },
    "Keyboard shortcuts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis clavier"
          }
        }
      }
    },
    "Keyboard shortcuts, Siri, Shortcuts and Spotlight.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis clavier, Siri, Raccourcis et Spotlight."
          }
        }
      }
    },
    "Kind of rack": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Type de rangement"
          }
        }
      }
    },
    "Kind of storage": {
