      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un modèle dans les réglages."
          }
        }
      }
    },
    "Choose a model that reads images. Larger models are more accurate but slower and cost more.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un modèle qui lit les images. Les grands modèles sont plus précis mais plus lents et plus chers."
          }
        }
      }
    },
    "Choose a photo of the label": {
