    },
    "Aromas in your tastings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arômes de vos dégustations"
          }
        }
      }
    },
    "Aromas you found that were not expected: every bottle and every palate is different.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les arômes trouvés qui n’étaient pas attendus : chaque bouteille et chaque palais sont différents."
