            "value": "Ne fonctionne pas"
          }
        }
      }
    },
    "Note a Wine Tasted Elsewhere": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter un vin goûté ailleurs"
          }
        }
      }
    },
    "Note a Wine Tasted Elsewhere…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter un vin goûté ailleurs…"
          }
        }
      }
    },
    "Note a bottle opened from your cellar or a wine tasted elsewhere": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter une bouteille ouverte de votre cave ou un vin goûté ailleurs"
          }
        }
      }
    },
    "Note a wine tasted elsewhere": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter un vin goûté ailleurs"
          }
        }
      }
    },
    "Notes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes"
          }
        }
      }
    },
    "Notes about this wine": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes sur ce vin"
          }
        }
      }
    },
    "Nothing here yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l’instant"
          }
        }
      }
    },
    "Nothing is at its peak right now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est à son apogée en ce moment"
          }
        }
      }
    },
    "Nothing is looked up online until you choose a service in **Settings › Web Search**.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est cherché en ligne tant que vous n’avez pas choisi un service dans **Réglages › Recherche web**."
          }
        }
      }
    },
    "Nothing new in these results.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau dans ces résultats."
          }
        }
      }
    },
    "Nothing new: everything in this file is already in your cellar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau : tout ce que contient ce fichier est déjà dans votre cave."
          }
        }
      }
    },
    "Nothing to suggest yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à suggérer pour l’instant"
          }
        }
      }
    },
    "Notifications are off for Encave. Turn them on in the system settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Encave. Activez-les dans les réglages du système."
          }
        }
      }
    },
    "Now ready: %lld": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désormais prêtes : %lld"
          }
        }
      }
    },
    "Now: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuel : %@"
          }
        }
      }
    },
    "Now: not set": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuel : non renseigné"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Occasion": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Occasion"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé"
          }
        }
      }
    },
    "Off by default": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivée par défaut"
          }
        }
      }
    },
    "Offset rows, like metal or terracotta racks, or bottles stacked on fridge shelves": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangées décalées, comme les casiers en métal ou en terre cuite, ou bouteilles empilées sur les étagères d’une cave à vin"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé"
          }
        }
      }
    },
    "On Order": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En commande"
          }
        }
      }
    },
    "On a new device with an empty cellar, **Join a Cellar from Another Device** shows how to bring in the cellar of your iPhone, iPad, Mac or Android: on that device, open **Settings › Devices › Add a Device** and type or scan the code it shows.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un nouvel appareil dont la cave est vide, **Rejoindre la cave d’un autre appareil** permet d’y faire venir la cave de votre iPhone, iPad, Mac ou Android : sur cet appareil, ouvrez **Réglages › Appareils › Ajouter un appareil** et saisissez ou scannez le code qu’il affiche."
          }
        }
      }
    },
    "On a wine's page, **Change Picture…** then **Search Pictures** finds pictures of the bottle with the same service. The one you tap is downloaded from its site and shown for the wine; the label photo is always kept. The thumbnails and the picture come from the sites that host them, which see the request. Pictures from shops are for your private use.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la fiche d’un vin, **Changer l’image…** puis **Chercher des images** trouve des images de la bouteille avec le même service. Celle que vous touchez est téléchargée depuis son site et affichée pour le vin ; la photo de l’étiquette est toujours conservée. Les miniatures et l’image viennent des sites qui les hébergent, qui voient la requête. Les images des boutiques sont pour votre usage privé."
          }
        }
      }
    },
    "On a wine's page, **Find Current Price** searches for the wine, its bottle size when it is not 75 cl, and the word “price”. Every price found is listed with its site; prices for several bottles, delivery or another size are left out. The middle value in your currency is suggested: change it or tap another price, then **Save Price**. Insights adds up these prices for the bottles in your cellar as the **estimated value today**. With Apple Intelligence, **Estimate on This Device** reads the prices on the device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la fiche d’un vin, **Trouver le prix actuel** cherche le vin, son format s’il n’est pas de 75 cl, et le mot « prix ». Chaque prix trouvé est listé avec son site ; les prix pour plusieurs bouteilles, la livraison ou un autre format sont écartés. La valeur médiane dans votre devise est proposée : modifiez-la ou touchez un autre prix, puis **Enregistrer le prix**. Les Statistiques additionnent ces prix pour les bouteilles de votre cave en **valeur estimée aujourd’hui**. Avec Apple Intelligence, **Estimer sur cet appareil** lit les prix sur l’appareil."
          }
        }
      }
    },
    "On a wine's page, or while adding or editing a wine, tap **Search Online**. The search terms are shown first and you can change them; nothing is sent until you tap **Search**. Each result shows its title, a snippet and the site, and opens in your browser. Touch and hold the producer or the appellation on a wine's page to search the web for it alone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la fiche d’un vin, ou en ajoutant ou modifiant un vin, touchez **Chercher en ligne**. Les termes de recherche s’affichent d’abord et vous pouvez les modifier ; rien n’est envoyé avant que vous touchiez **Chercher**. Chaque résultat affiche son titre, un extrait et le site, et s’ouvre dans votre navigateur. Touchez longuement le producteur ou l’appellation sur la fiche d’un vin pour le chercher seul sur le Web."
          }
        }
      }
    },
    "On devices with Apple Intelligence, **Ask your cellar** in Tonight answers a question such as “something light for a ratatouille” with bottles you own. The answer is worked out on the device: neither the question nor your cellar is sent anywhere. In a large cellar, the model reads only part of it, the wines closest to the question and the most urgent, and the answer says so.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les appareils avec Apple Intelligence, **Demander à votre cave** dans Ce soir répond à une question comme « quelque chose de léger pour une ratatouille » avec des bouteilles que vous avez. La réponse est calculée sur l’appareil : ni la question ni votre cave ne sont envoyées. Dans une grande cave, le modèle n’en lit qu’une partie, les vins les plus proches de la question et les plus urgents, et la réponse le dit."
          }
        }
      }
    },
    "On devices with Apple Intelligence, **Suggest Details** reads the results on the device and proposes the producer, region, appellation, country, grapes and drinking window. Each suggestion is shown next to the current value, and only the ones you select are used. The results are not sent to any AI service.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les appareils avec Apple Intelligence, **Suggérer des détails** lit les résultats sur l’appareil et propose le producteur, la région, l’appellation, le pays, les cépages et la fenêtre de dégustation. Chaque suggestion s’affiche à côté de la valeur actuelle, et seules celles que vous choisissez sont utilisées. Les résultats ne sont envoyés à aucun service d’IA."
          }
        }
      }
    },
    "On iPad and Mac, in racks with one bottle per place, drag a bottle to another place to move it, or onto another bottle of the same rack to swap them. **Undo** puts them back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPad et Mac, dans les casiers à une bouteille par place, faites glisser une bouteille vers une autre place pour la déplacer, ou sur une autre bouteille du même casier pour les échanger. **Annuler** les remet en place."
          }
        }
      }
    },
    "On iPhone and iPad, **+** in the Cellar opens the camera: point it at the label and tap **Use This Label**, or choose a photo (**Cancel** takes you to the form to type the wine). On the Mac, **Scan the Label** in the add form reads a photo you choose. The text is read on the device and fills in the name, producer, vintage and appellation; choose the style and check the vintage right below. Nothing is sent anywhere. The first time, Encave asks for the camera; if it is off, **Open Settings** turns it on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone et iPad, **+** dans la Cave ouvre l’appareil photo : visez l’étiquette et touchez **Utiliser cette étiquette**, ou choisissez une photo (**Annuler** ramène au formulaire pour saisir le vin). Sur Mac, **Scanner l’étiquette** dans le formulaire d’ajout lit une photo que vous choisissez. Le texte est lu sur l’appareil et remplit le nom, le producteur, le millésime et l’appellation ; choisissez le style et vérifiez le millésime juste en dessous. Rien n’est envoyé nulle part. La première fois, Encave demande l’accès à l’appareil photo ; s’il est désactivé, **Ouvrir les réglages** permet de l’activer."
          }
        }
      }
    },
    "On iPhone and iPad, use your computer’s address on the network instead of localhost. Choose a model that reads images for label recognition.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone et iPad, utilisez l’adresse de votre ordinateur sur le réseau au lieu de localhost. Choisissez un modèle qui lit les images pour reconnaître les étiquettes."
          }
        }
      }
    },
    "On order": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En commande"
          }
        }
      }
    },
    "On order: %lld × %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En commande : %1$lld × %2$@"
          }
        }
      }
    },
    "On shelves": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur étagères"
          }
        }
      }
    },
    "On the Mac and the iPad, the buttons at the top of the Cellar show it as a list or as a table that sorts by any column, with the selected wine beside it. Both keep the same search and filters; in the table, **Filter** sets them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur Mac et iPad, les boutons en haut de la Cave l’affichent en liste ou en tableau triable par n’importe quelle colonne, avec le vin sélectionné à côté. Les deux gardent la même recherche et les mêmes filtres ; dans le tableau, **Filtrer** les règle."
          }
        }
      }
    },
    "On the Mac, and on iPad with a keyboard.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur Mac, et sur iPad avec un clavier."
          }
        }
      }
    },
    "On the device that already has your cellar: Settings › Devices › Add a Device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’appareil qui a déjà votre cave : Réglages › Appareils › Ajouter un appareil."
          }
        }
      }
    },
    "On the device that has your cellar, open **Settings › Devices › Add a Device**: it shows a QR code and a 6-digit code. On the new device, scan the QR code with the camera (Encave opens with the code filled in: tap **Join**), or choose **Join Another Device’s Cellar** and scan it there (iPhone and iPad) or type the 6-digit code. The code is valid for 2 minutes, for one device. Both devices must be on the same Wi-Fi, and Encave needs Local Network access: if it is off, Encave says so, and **Open Settings** takes you to the switch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’appareil qui a votre cave, ouvrez **Réglages › Appareils › Ajouter un appareil** : il affiche un code QR et un code à 6 chiffres. Sur le nouvel appareil, scannez le code QR avec l’appareil photo (Encave s’ouvre avec le code déjà saisi : touchez **Rejoindre**), ou choisissez **Rejoindre la cave d’un autre appareil** et scannez-le là (iPhone et iPad) ou saisissez le code à 6 chiffres. Le code est valable 2 minutes, pour un seul appareil. Les deux appareils doivent être sur le même Wi-Fi, et Encave doit avoir accès au réseau local : si cet accès est désactivé, Encave le signale, et **Ouvrir les réglages** mène à l’option."
          }
        }
      }
    },
    "On the first of each month, if bottles should be drunk this year, have just become ready or are past their peak, and on the day bottles on order are expected. Worked out on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier de chaque mois, si des bouteilles sont à boire cette année, viennent d’être prêtes ou ont passé leur apogée, et le jour où des bouteilles en commande sont attendues. Calculé sur cet appareil."
          }
        }
      }
    },
    "On the first of each month, if bottles should be drunk this year, have just become ready or are past their peak. Worked out on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier de chaque mois, si des bouteilles sont à boire cette année, viennent d’être prêtes ou ont passé leur apogée. Calculé sur cet appareil."
          }
        }
      }
    },
    "On the same Wi-Fi": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le même Wi-Fi"
          }
        }
      }
    },
    "On the same Wi-Fi, changes are sent a few seconds after you make them. This setting is for this device only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le même Wi-Fi, les modifications partent quelques secondes après les avoir faites. Ce réglage ne concerne que cet appareil."
          }
        }
      }
    },
    "On the same Wi-Fi, devices talk directly; no server is involved. Through iCloud, a WebDAV folder or a relay, only encrypted files are stored there. Every exchange is encrypted from end to end. The 6-digit code only helps the devices find each other: the comparison is what protects you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le même Wi-Fi, les appareils communiquent directement ; aucun serveur n’intervient. Avec iCloud, un dossier WebDAV ou un relais, seuls des fichiers chiffrés y sont stockés. Chaque échange est chiffré de bout en bout. Le code à 6 chiffres sert seulement à ce que les appareils se trouvent : c’est la comparaison qui vous protège."
          }
        }
      }
    },
    "On the wine's page, **Change Picture…** shows instead an illustration made on this device with Image Playground (with Apple Intelligence), or a picture found on the internet if a search service is set up. The label photo is always kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la fiche du vin, **Changer l’image…** affiche à la place une illustration créée sur cet appareil avec Image Playground (avec Apple Intelligence), ou une image trouvée sur internet si un service de recherche est configuré. La photo d’étiquette est toujours gardée."
          }
        }
      }
    },
    "On this device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet appareil"
          }
        }
      }
    },
    "On this network": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ce réseau"
          }
        }
      }
    },
    "Once another device has been added, to sync when your devices are not on the same Wi-Fi, open **Devices › Sync Away from Home**. Choose **Use iCloud** if it is offered (for Apple devices on the same Apple Account; Android devices cannot use it), a **WebDAV folder** you already have, or the address of a relay: a small open-source service that only stores encrypted files. You can run your own (instructions in the link on that page) or use one run by someone you trust. Devices that do not sync away from home yet take it up the next time they meet on the same Wi-Fi; turning it off or changing it applies to this device only, after you confirm. If Android devices share the cellar, choose a WebDAV folder or a relay on every device: devices already on iCloud do not switch by themselves.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois un autre appareil ajouté, pour synchroniser quand vos appareils ne sont pas sur le même Wi-Fi, ouvrez **Appareils › Synchroniser loin de la maison**. Choisissez **Utiliser iCloud** si l’option est proposée (pour les appareils Apple connectés au même compte Apple ; les appareils Android ne peuvent pas l’utiliser), un **dossier WebDAV** que vous avez déjà, ou l’adresse d’un relais : un petit service open source qui ne stocke que des fichiers chiffrés. Vous pouvez héberger le vôtre (instructions dans le lien de cette page) ou utiliser celui d’une personne de confiance. Les appareils qui ne se synchronisent pas encore à distance le reprennent la prochaine fois qu’ils se retrouvent sur le même Wi-Fi ; le désactiver ou le changer ne concerne que cet appareil, après confirmation. Si des appareils Android partagent la cave, choisissez un dossier WebDAV ou un relais sur chaque appareil : ceux déjà sur iCloud ne changent pas d’eux-mêmes."
          }
        }
      }
    },
    "One": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une"
          }
        }
      }
    },
    "One bottle per cell, in rows and columns. For racks deep enough to hold one bottle behind the other, set **Bottles per cell** to **Two, one behind the other**.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bouteille par case, en rangées et colonnes. Pour les casiers assez profonds pour tenir une bouteille derrière l’autre, réglez **Bouteilles par case** sur **Deux, l’une derrière l’autre**."
          }
        }
      }
    },
    "One bottle per cell, single or double depth": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bouteille par case, simple ou double profondeur"
          }
        }
      }
    },
    "One diary": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul carnet"
          }
        }
      }
    },
    "Only %lld free places: the other bottles will have no place.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Only %lld free place: the other bottles will have no place."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Only %lld free places: the other bottles will have no place."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Seulement %lld place libre : les autres bouteilles n’auront pas de place."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Seulement %lld places libres : les autres bouteilles n’auront pas de place."
                }
              }
            }
          }
        }
      }
    },
    "Only encrypted files are stored. Neither Apple, the WebDAV server nor a relay can see your wines, photos or device names.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls des fichiers chiffrés sont stockés. Ni Apple, ni le serveur WebDAV, ni un relais ne peuvent voir vos vins, vos photos ou le nom de vos appareils."
          }
        }
      }
    },
    "Only the **name** is required. The producer and the vintage help tell wines apart; leave the vintage on **Non-vintage** for champagnes and blends without a year.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le **nom** est obligatoire. Le producteur et le millésime aident à distinguer les vins ; laissez le millésime sur **Non millésimé** pour les champagnes et assemblages sans année."
          }
        }
      }
    },
    "Only the label photo is sent, directly to this service, when you scan a label or tap “Complete with AI”. Your cellar is never sent. The key is stored in the Keychain on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la photo de l’étiquette est envoyée, directement à ce service, quand vous scannez une étiquette ou touchez « Compléter avec l’IA ». Votre cave n’est jamais envoyée. La clé est conservée dans le trousseau de cet appareil."
          }
        }
      }
    },
    "Only the label photo is sent, to your own server. On iPhone and iPad, use the computer’s IP address or its name ending in .local instead of localhost.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la photo de l’étiquette est envoyée, à votre propre serveur. Sur iPhone et iPad, utilisez l’adresse IP de l’ordinateur ou son nom terminé par .local au lieu de localhost."
          }
        }
      }
    },
    "Only the label photo, when you scan a label or tap **Complete with AI**. Your cellar, notes and prices are never sent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement la photo de l’étiquette, quand vous scannez une étiquette ou touchez **Compléter avec l’IA**. Votre cave, vos notes et vos prix ne sont jamais envoyés."
          }
        }
      }
    },
    "Only the name is required. Producer and vintage tell apart wines with the same name.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le nom est obligatoire. Le producteur et le millésime distinguent les vins du même nom."
          }
        }
      }
    },
    "Only the search terms are sent to %@. The thumbnails and the picture you choose are downloaded from the sites that host them, which see the request and your IP address. Pictures from shops are for your private use. The label photo is kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les termes de recherche sont envoyés à %@. Les miniatures et l’image que vous choisissez sont téléchargées depuis les sites qui les hébergent, qui voient la requête et votre adresse IP. Les images des boutiques sont pour votre usage privé. La photo de l’étiquette est conservée."
          }
        }
      }
    },
    "Only the search terms are sent, directly to this service, when you tap Search: the producer, name, appellation and vintage of the wine, and the bottle size for a price. You see them and can change them first. Your cellar, notes and prices are never sent. When you search pictures, the thumbnails and the picture you choose are downloaded from the sites that host them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les termes de recherche sont envoyés, directement à ce service, quand vous touchez Chercher : le producteur, le nom, l’appellation et le millésime du vin, et le format de la bouteille pour un prix. Vous les voyez et pouvez les modifier avant. Votre cave, vos notes et vos prix ne sont jamais envoyés. Quand vous cherchez des images, les miniatures et l’image choisie sont téléchargées depuis les sites qui les hébergent."
          }
        }
      }
    },
    "Only the search terms, to the service you chose: by default the producer, the name, the appellation and the vintage, with the word “wine” (“bottle” for pictures); for a price, the word “price” and the bottle size when it is not 75 cl. You see them and can change them first. Your cellar, notes, prices and places are never sent. The key is stored in the Keychain on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement les termes de recherche, au service que vous avez choisi : par défaut le producteur, le nom, l’appellation et le millésime, avec le mot « vin » (« bouteille » pour les images) ; pour un prix, le mot « prix » et le format s’il n’est pas de 75 cl. Vous les voyez et pouvez les modifier avant. Votre cave, vos notes, vos prix et vos places ne sont jamais envoyés. La clé est conservée dans le trousseau de cet appareil."
          }
        }
      }
    },
    "Only these words are sent, to %@, when you tap Search. Change them if you like. Nothing else about this wine or your cellar is sent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls ces mots sont envoyés, à %@, quand vous touchez Chercher. Modifiez-les si vous le souhaitez. Rien d’autre sur ce vin ou votre cave n’est envoyé."
          }
        }
      }
    },
    "Only when I tap Sync Now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement quand je touche Synchroniser"
          }
        }
      }
    },
    "Only when you tap Sync Now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement quand vous touchez Synchroniser"
          }
        }
      }
    },
    "Open Encave": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Encave"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages"
          }
        }
      }
    },
    "Open Wine": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le vin"
          }
        }
      }
    },
    "Open a Bottle": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir une bouteille"
          }
        }
      }
    },
    "Open a bottle": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir une bouteille"
          }
        }
      }
    },
    "Open a bottle from your cellar or note a wine tasted elsewhere.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une bouteille de votre cave ou notez un vin goûté ailleurs."
          }
        }
      }
    },
    "Open in Browser": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir dans le navigateur"
          }
        }
      }
    },
    "Open the provider's page with the link below the key field, create a key and paste it. The key is stored in the Keychain on this device and sent only to that provider.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la page du fournisseur avec le lien sous le champ de la clé, créez une clé et collez-la. La clé est conservée dans le trousseau de cet appareil et n’est envoyée qu’à ce fournisseur."
          }
        }
      }
    },
    "Open this help (Mac)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir cette aide (Mac)"
          }
        }
      }
    },
    "Open-source libraries included in Encave, each under its own licence.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothèques open source incluses dans Encave, chacune sous sa propre licence."
          }
        }
      }
    },
    "OpenAI-compatible": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible OpenAI"
          }
        }
      }
    },
    "Opens Encave to add bottles, by scanning the label or typing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Encave pour ajouter des bouteilles, en scannant l’étiquette ou en saisissant."
          }
        }
      }
    },
    "Opens Settings, then choose Devices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les réglages ; choisissez ensuite Appareils."
          }
        }
      }
    },
    "Opens the document.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le document."
          }
        }
      }
    },
    "Opens the page in your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la page dans votre navigateur."
          }
        }
      }
    },
    "Opens the system settings, to turn on notifications for Encave.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les réglages du système, pour activer les notifications d’Encave."
          }
        }
      }
    },
    "Opens the wine in Encave.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le vin dans Encave."
          }
        }
      }
    },
    "Optional, in **Devices › Sync Away from Home**: iCloud (Apple devices on the same Apple Account), a WebDAV folder (a NAS, Nextcloud, pCloud) or a relay you trust. Each device leaves an encrypted copy of the cellar there a few seconds after a change, and reads the others’ while Encave is open, every minute unless you choose otherwise. iPhone and iPad also sync in the background when iOS allows, typically every 15 minutes to a few hours; a Mac syncs while Encave is open. The storage only ever sees encrypted files.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif, dans **Appareils › Synchroniser loin de la maison** : iCloud (appareils Apple connectés au même compte Apple), un dossier WebDAV (un NAS, Nextcloud, pCloud) ou un relais de confiance. Chaque appareil y dépose une copie chiffrée de la cave quelques secondes après une modification, et lit celles des autres quand Encave est ouvert, toutes les minutes sauf si vous choisissez une autre fréquence. L’iPhone et l’iPad se synchronisent aussi en arrière-plan quand iOS le permet, en général toutes les 15 minutes à quelques heures ; un Mac se synchronise quand Encave est ouvert. Le stockage ne voit jamais que des fichiers chiffrés."
          }
        }
      }
    },
    "Optional. Helps you remember where to buy a wine again and what your cellar is worth.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Pour retrouver où racheter un vin et connaître la valeur de votre cave."
          }
        }
      }
    },
    "Optional. Looks up a wine on the web to complete its details or find its current price, with the search service you choose.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Cherche un vin sur le web pour compléter sa fiche ou trouver son prix actuel, avec le service de recherche de votre choix."
          }
        }
      }
    },
    "Optional. Makes search and food pairing better. Separate grapes with commas.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Améliore la recherche et les accords mets-vins. Séparez les cépages par des virgules."
          }
        }
      }
    },
    "Optional. Reads labels from a photo with the AI service you choose, using your own API key.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Lit les étiquettes sur une photo avec le service d’IA de votre choix et votre propre clé d’API."
          }
        }
      }
    },
    "Optional. Reads the label from a photo with the AI service you choose, using your own API key.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Lit l’étiquette sur une photo avec le service d’IA de votre choix et votre propre clé d’API."
          }
        }
      }
    },
    "Optional: price per bottle, date, shop or the person who gave it to you. Prices are used for the value of your cellar in Insights.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : prix par bouteille, date, caviste ou personne qui vous l’a offerte. Les prix servent à la valeur de votre cave dans les Statistiques."
          }
        }
      }
    },
