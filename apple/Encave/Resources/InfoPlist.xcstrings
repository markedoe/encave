{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave uses the camera to read wine labels. Images stay on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave utilise l’appareil photo pour lire les étiquettes. Les images restent sur cet appareil."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave finds your other devices on this network to sync your cellar, encrypted from end to end. It also reaches the AI server you may set in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave trouve vos autres appareils sur ce réseau pour synchroniser votre cave, chiffrée de bout en bout. Il joint aussi le serveur d’IA que vous pouvez choisir dans les réglages."
          }
        }
      }
    }
  },
  "version": "1.0"
}
