{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave uses the camera to read wine labels and barcodes, scan documents and scan the pairing code of your other devices. Images stay on your devices unless you turn on AI label recognition, which sends only the label photo to the service you chose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave utilise l’appareil photo pour lire les étiquettes et les codes-barres, numériser des documents et scanner le code d’appairage de vos autres appareils. Les images restent sur vos appareils, sauf si vous activez la reconnaissance des étiquettes par IA, qui envoie seulement la photo de l’étiquette au service que vous avez choisi."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave finds your other devices on this network to sync your cellar with them, encrypted from end to end. It also connects to the servers on this network you set up in Settings, such as an AI or web search server or a WebDAV folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave trouve vos autres appareils sur ce réseau pour y synchroniser votre cave, chiffrée de bout en bout. Il se connecte aussi aux serveurs de ce réseau que vous choisissez dans les réglages, comme un serveur d’IA ou de recherche web, ou un dossier WebDAV."
          }
        }
      }
    },
    "Encave bottle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encave bottle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouteille Encave"
          }
        }
      }
    }
  },
  "version": "1.0"
}
