{
  "$description": "Encave design tokens (W3C design tokens format). Single source of truth for Apple and Android. Run design/generate_apple_assets.py after editing.",
  "color": {
    "accent":         { "$type": "color", "$value": { "light": "#8E1E3A", "dark": "#E0607A" }, "$description": "Single brand accent (burgundy)" },
    "wine-red":       { "$type": "color", "$value": { "light": "#8C1C2B", "dark": "#C8454F" } },
    "wine-white":     { "$type": "color", "$value": { "light": "#C9BE4E", "dark": "#C7BD55" } },
    "wine-rose":      { "$type": "color", "$value": { "light": "#F0A0AA", "dark": "#E58A95" } },
    "wine-sparkling": { "$type": "color", "$value": { "light": "#F3E6C4", "dark": "#EFE3C2" } },
    "wine-dessert":   { "$type": "color", "$value": { "light": "#C8902E", "dark": "#D9A441" } },
    "wine-fortified": { "$type": "color", "$value": { "light": "#6B2D2D", "dark": "#A2524A" } },
    "wine-orange":    { "$type": "color", "$value": { "light": "#E39B4C", "dark": "#EBA35A" } },
    "studio-backdrop": { "$type": "color", "$value": { "light": "#F5EFEC", "dark": "#1C1719" }, "$description": "Base of the studio backdrop behind label photos and covers; the wine color is laid over it as a gradient" },
    "studio-red":        { "$type": "color", "$value": { "light": "#EBCDD2", "dark": "#5C1322" }, "$description": "Studio backdrop for this wine style (top of its gradient); deep and rich in dark mode, behind a cream label" },
    "studio-white":      { "$type": "color", "$value": { "light": "#F2EAC4", "dark": "#64501A" } },
    "studio-rose":       { "$type": "color", "$value": { "light": "#F9DDE1", "dark": "#6A2638" } },
    "studio-sparkling":  { "$type": "color", "$value": { "light": "#F4EDDA", "dark": "#4E4530" } },
    "studio-dessert":    { "$type": "color", "$value": { "light": "#F2DDB0", "dark": "#64400F" } },
    "studio-fortified":  { "$type": "color", "$value": { "light": "#E6CDCB", "dark": "#46181A" } },
    "studio-orange":     { "$type": "color", "$value": { "light": "#F6DBBF", "dark": "#693510" } },
    "launch-background": { "$type": "color", "$value": { "light": "#FEFCFC", "dark": "#120F10" }, "$description": "Android launch window before the first frame (the brand scheme's background)" },
    "maturity-drink-soon": { "$type": "color", "$value": { "light": "#A65A00", "dark": "#F5A54A" }, "$description": "Maturity symbols; always with a word, at least 4.5:1 on the background" },
    "maturity-ready":      { "$type": "color", "$value": { "light": "#2E7D32", "dark": "#81C784" } },
    "maturity-past-peak":  { "$type": "color", "$value": { "light": "#B3261E", "dark": "#F2B8B5" } },
    "maturity-keep":       { "$type": "color", "$value": { "light": "#00695C", "dark": "#4DB6AC" } },
    "warning":        { "$type": "color", "$value": { "light": "#8F5300", "dark": "#F2B04A" }, "$description": "Text and icons of a warning (at least 4.5:1 on the light and dark backgrounds); always next to an icon or words" }
  },
  "spacing": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32 },
  "radius": { "chip": 6, "cell": 10, "card": 16 },
  "touchTarget": { "apple": 44, "android": 48 }
}
